  "narrative": {
    "northStar": "The Coachbuilder's Archive",
    "overview": "The register presents cars with the care of an automotive editorial while remaining a working inventory. Warm paper, oxblood, graphite ink, and restrained copper suggest leather and metal without imitating a literal ledger. A single automotive image sets the atmosphere; vehicle names and records carry the daily work.\n\nThe same visual system serves a personal collection and a dealership's stock. Editorial serif identifies the place and the machines; precise sans type keeps controls, labels, and data quick to scan. Density comes from aligned rows and a compact summary, with a selected vehicle promoted into a dark dossier.",
    "keyCharacteristics": [
      "Warm, tactile color with a dark graphite masthead and dossier.",
      "Large serif identity and vehicle names paired with small, orderly sans labels.",
      "A dense collection table beside a selected record on wide screens.",
      "Restrained copper accents and one photographic strip."
    ],
    "rules": [
      {
        "name": "The Accent Rule",
        "body": "Use oxblood for action and copper for the archive's identity and focus; keep both selective so the vehicle data remains prominent.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Reserve Newsreader for identity and vehicle emphasis; use Barlow for operational text and data.",
        "section": "typography"
      },
      {
        "name": "The Overlay Rule",
        "body": "Save pronounced shadows for panels that cover the workspace; use borders and tonal contrast for resting content.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep vehicle names visually prominent and registrations and prices easy to compare.",
      "Do pair serif display moments with sans controls and data.",
      "Do use the paper, ink, oxblood, and copper roles consistently across personal and dealer workflows.",
      "Do retain visible focus and clear empty, error, and success states."
    ],
    "donts": [
      "Don't turn the working inventory into a loose grid of white cards.",
      "Don't apply overlay shadows to every resting surface.",
      "Don't use decorative automotive motifs in place of clear controls or data labels."
    ]
  }
}
